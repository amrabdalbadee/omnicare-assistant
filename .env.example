# ---- LLM provider -------------------------------------------------------
# One of: groq | anthropic | openai | ollama
LLM_PROVIDER=groq

# Model name for the selected provider.
# groq      -> llama-3.3-70b-versatile
# anthropic -> claude-sonnet-4-5
# openai    -> gpt-4o-mini
# ollama    -> qwen2.5:7b
LLM_MODEL=llama-3.3-70b-versatile

# Only the key for your chosen provider is required.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Retrieval ----------------------------------------------------------
# chroma  -> local Chroma vector store with on-device embeddings (default)
# keyword -> dependency-free lexical fallback, used by the test suite
RAG_BACKEND=chroma
